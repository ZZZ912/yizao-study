{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yizao-study.local/schemas/question.schema.json",
  "title": "Yizao private question ingestion record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "external_id",
    "subject",
    "chapter",
    "section",
    "question_type",
    "stem",
    "options",
    "answer",
    "source_file",
    "source_page",
    "source_type",
    "rights_scope",
    "public_repo_allowed",
    "content_origin",
    "extraction_method",
    "extraction_confidence",
    "review_status",
    "warnings"
  ],
  "properties": {
    "external_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "subject": {"type": "string", "minLength": 1},
    "chapter": {"type": "integer", "minimum": 1},
    "chapter_title": {"type": "string"},
    "section": {"type": "integer", "minimum": 1},
    "section_title": {"type": "string"},
    "question_number": {"type": ["integer", "string"]},
    "question_type": {"enum": ["single_choice", "multiple_choice"]},
    "stem": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 12},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "answer": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 12}
    },
    "analysis": {"type": "string"},
    "difficulty": {"type": "string"},
    "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
    "applicable_exam_edition": {"type": "string"},
    "source_file": {"type": "string", "minLength": 1},
    "source_page": {"type": "integer", "minimum": 1},
    "source_type": {"type": "string", "minLength": 1},
    "institution": {"type": "string"},
    "source_title": {"type": "string"},
    "rights_scope": {"type": "string", "minLength": 1},
    "public_repo_allowed": {"type": "boolean"},
    "content_origin": {"type": "string", "minLength": 1},
    "extraction_method": {"type": "string", "minLength": 1},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {"enum": ["pending", "pending_review", "reviewed", "disputed"]},
    "warnings": {"type": "array"}
  },
  "allOf": [
    {
      "if": {"properties": {"question_type": {"const": "single_choice"}}},
      "then": {"properties": {"answer": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"question_type": {"const": "multiple_choice"}}},
      "then": {"properties": {"answer": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"rights_scope": {"const": "private_personal_use"}}},
      "then": {"properties": {"public_repo_allowed": {"const": false}}}
    }
  ]
}
